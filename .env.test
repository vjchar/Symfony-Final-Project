# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# HardeningTest uses 203.0.113.0/24 (TEST-NET-3) as an allowed but non-local network
DEBUG_ALLOWED_IPS=127.0.0.1,::1,203.0.113.0/24

# The test suite creates its own vj_car_rental_test database, so it needs the root account.
DATABASE_URL="mysql://root:${MYSQL_ROOT_PASSWORD}@127.0.0.1:3310/${MYSQL_DATABASE}?serverVersion=8.0.32&charset=utf8mb4"

# Fixed payment accounts so tests do not depend on anyone's real details
PAYMENT_GCASH_NAME="Test GCash Name"
PAYMENT_GCASH_NUMBER="0917 000 1234"
PAYMENT_BANK_NAME="Test Bank"
PAYMENT_BANK_ACCOUNT_NAME="Test Account Name"
PAYMENT_BANK_ACCOUNT_NUMBER="1111 2222 3333"
