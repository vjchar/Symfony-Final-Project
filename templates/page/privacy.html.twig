{% extends 'base.html.twig' %}

{% block title %}Privacy Policy | VJ Car Rental{% endblock %}
{% block description %}Review the privacy policy for VJ Car Rental.{% endblock %}

{% block body %}

<section class="page-hero page-hero--legal pattern-layer">
    <div class="container">
        <span class="section-kicker">Your information matters</span>
        <h1>Privacy Policy</h1>
        <p>Last updated: August 26, 2026</p>
    </div>
</section>
<section class="content-section legal-section">
    <div class="container">
        <div class="row g-5">
            <aside class="col-lg-3">
                <nav class="legal-nav" aria-label="Privacy contents">
                    <strong>On this page</strong>
                    <a href="#scope">1. Scope</a>
                    <a href="#collect">2. Information collected</a>
                    <a href="#use-data">3. How information is used</a>
                    <a href="#sharing">4. Sharing</a>
                    <a href="#security">5. Security</a>
                    <a href="#rights">6. Your choices</a>
                    <a href="#retention">7. Retention</a>
                    <a href="#privacy-contact">8. Contact</a>
                </nav>
            </aside>
            <article class="col-lg-9 legal-copy">
                <div class="legal-notice">
                    <i class="bi bi-shield-check"></i>
                    <p>This policy explains how VJ Car Rental handles personal information used for inquiries, reservations, rentals, payments, and customer support.</p>
                </div>
                <section id="scope">
                    <span>01</span>
                    <div>
                        <h2>Scope of this policy</h2>
                        <p>This page describes how VJ Car Rental may handle information when customers browse the website, request support, make a reservation, rent a vehicle, or communicate with the company.</p>
                    </div>
                </section>
                <section id="collect">
                    <span>02</span>
                    <div>
                        <h2>Information we may collect</h2>
                        <p>Information may include contact details, driver's license and identity information, booking and payment details, rental history, vehicle condition records, support messages, and basic technical information generated when you use the website.</p>
                    </div>
                </section>
                <section id="use-data">
                    <span>03</span>
                    <div>
                        <h2>How information may be used</h2>
                        <p>Information may be used to respond to inquiries, verify eligibility, prepare and manage rentals, process authorized payments, provide support, protect vehicles and customers, comply with legal obligations, and improve service quality.</p>
                    </div>
                </section>
                <section id="sharing">
                    <span>04</span>
                    <div>
                        <h2>When information may be shared</h2>
                        <p>Information may be shared with authorized service providers, payment processors, insurers, roadside assistance partners, professional advisers, or government authorities when necessary, lawful, and consistent with applicable policies.</p>
                    </div>
                </section>
                <section id="security">
                    <span>05</span>
                    <div>
                        <h2>Information security</h2>
                        <p>Reasonable administrative, physical, and technical safeguards should be used to protect personal information. No method is completely secure, so access should be limited to authorized personnel with a valid operational need.</p>
                    </div>
                </section>
                <section id="rights">
                    <span>06</span>
                    <div>
                        <h2>Your privacy choices</h2>
                        <p>Subject to applicable law, customers may ask about their information, request corrections, withdraw consent where appropriate, or request deletion when retention is no longer required. Identity verification may be required before a request is completed.</p>
                    </div>
                </section>
                <section id="retention">
                    <span>07</span>
                    <div>
                        <h2>Retention</h2>
                        <p>Personal information should be kept only for as long as necessary for the purpose it was collected, legitimate business needs, dispute resolution, safety, and legal or accounting requirements.</p>
                    </div>
                </section>
                <section id="privacy-contact">
                    <span>08</span>
                    <div>
                        <h2>Privacy contact</h2>
                        <p>For a privacy question or request, contact bernardinovjcharles@gmail.com or 
                            write to VJ Car Rental, Manjuyod, Metro Negros Oriental, Philippines.</p>
                    </div>
                </section>
            </article>
        </div>
    </div>
</section>
{% endblock %}
