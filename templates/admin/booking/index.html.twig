{% extends 'admin/base.html.twig' %}

{% block title %}Manage Bookings | VJ Car Rental{% endblock %}

{% macro review_form(route, id, token) %}
    <form class="admin-inline-form" method="post" action="{{ path(route, {id: id}) }}">
        <input type="hidden" name="_token" value="{{ csrf_token(token ~ id) }}">
        <select class="form-select form-select-sm" name="decision" required><option value="">Decision</option><option value="approved">Approve</option><option value="rejected">Reject</option></select>
        <input class="form-control form-control-sm" name="admin_note" maxlength="2000" placeholder="Admin note">
        <button class="btn btn-primary btn-sm" type="submit">Review</button>
    </form>
{% endmacro %}

{% macro status_form(route, token, booking, label, placeholder) %}
    <form class="admin-inline-form mb-1" method="post" action="{{ path(route, {id: booking.id}) }}" data-confirm="{{ label }} booking {{ booking.reference }}? The customer is notified.">
        <input type="hidden" name="_token" value="{{ csrf_token(token ~ booking.id) }}">
        <input class="form-control form-control-sm" name="admin_note" maxlength="2000" placeholder="{{ placeholder }}" aria-label="{{ placeholder }} for {{ booking.reference }}">
        <button class="btn btn-outline btn-sm" type="submit">{{ label }}</button>
    </form>
{% endmacro %}

{% block admin_body %}
{% import _self as f %}
<section class="admin-page-heading">
    <div class="container">
        <div>
            <span class="section-kicker">Reservations</span>
            <h1>Manage bookings</h1>
            <p>Approve reservations, prepare them for pickup, and hand active rentals to the Rental Desk using controlled status transitions.</p>
        </div>
    </div>
</section>
<section class="content-section admin-section">
    <div class="container">
        <div class="admin-ops-queues">
            <article class="admin-editor" id="modification-queue">
                <div class="admin-editor__heading"><div><span class="section-kicker">Pre-pickup changes</span><h2>Pending booking modifications</h2><p>Requested changes do not alter the authoritative booking until approval and any required additional payment are completed.</p></div><span class="dashboard-queue__count">{{ modifications|length }}</span></div>
                <div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Booking</th><th>Customer</th><th>Requested change</th><th>Price impact</th><th>Action</th></tr></thead><tbody>
                {% for modification in modifications %}
                    {% set booking = modification.booking %}
                    {% set requested = modification.requestedData %}
                    <tr>
                        <td><strong>{{ booking.reference }}</strong><small>{{ booking.vehicle.name }}</small></td>
                        <td>{{ modification.user.name }}<small>{{ modification.user.email }}</small></td>
                        <td><strong>{{ requested.vehicle_name ?? modification.requestedVehicle.name ?? 'Vehicle' }}</strong><small>{{ requested.pickup_at is defined ? requested.pickup_at|date('M j, Y g:i A') : '—' }} → {{ requested.return_at is defined ? requested.return_at|date('M j, Y g:i A') : '—' }}</small><small>{{ requested.pickup_method ?? '' }}</small></td>
                        <td>{{ modification.priceDifference >= 0 ? '+' : '−' }}{{ (modification.priceDifference|abs)|money }}</td>
                        <td>{{ f.review_form('app_admin_modification_review', modification.id, 'review-modification-') }}</td>
                    </tr>
                {% else %}
                    <tr><td colspan="5">No pending booking modifications.</td></tr>
                {% endfor %}
                </tbody></table></div>
            </article>

            <article class="admin-editor mt-4" id="cancellation-queue">
                <div class="admin-editor__heading"><div><span class="section-kicker">Cancellation control</span><h2>Pending cancellations</h2><p>Approve only eligible pre-pickup cancellations. Refund estimates are recalculated when the request is reviewed.</p></div><span class="dashboard-queue__count">{{ cancellations|length }}</span></div>
                <div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Booking</th><th>Customer</th><th>Reason</th><th>Refund estimate</th><th>Action</th></tr></thead><tbody>
                {% for cancellation in cancellations %}
                    <tr><td><strong>{{ cancellation.booking.reference }}</strong><small>{{ cancellation.booking.vehicle.name }}</small></td><td>{{ cancellation.user.name }}<small>{{ cancellation.user.email }}</small></td><td>{{ cancellation.reason }}</td><td><strong>{{ cancellation.refundableAmount|money }}</strong><small>{{ cancellation.nonRefundableAmount|money }} non-refundable</small></td><td>{{ f.review_form('app_admin_cancellation_review', cancellation.id, 'review-cancellation-') }}</td></tr>
                {% else %}
                    <tr><td colspan="5">No pending cancellation requests.</td></tr>
                {% endfor %}
                </tbody></table></div>
            </article>

            <article class="admin-editor mt-4" id="preparation-queue">
                <div class="admin-editor__heading"><div><span class="section-kicker">Vehicle preparation</span><h2>Ready for preparation</h2><p>Payment and documents are verified. Mark the vehicle ready once it is prepared; the Rental Desk then handles the checkout.</p></div><span class="status-badge status-badge--info">{{ preparing|length }} confirmed</span></div>
                <div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Booking</th><th>Customer</th><th>Handover</th><th>Fleet state</th><th>Action</th></tr></thead><tbody>
                {% for booking in preparing %}
                    <tr>
                        <td><strong>{{ booking.reference }}</strong><small>{{ booking.vehicle.name }}</small></td>
                        <td>{{ booking.user.name }}<small>{{ booking.user.email }}</small></td>
                        <td>{{ booking.pickupAt|date('M j, Y g:i A') }}<small>{{ booking.pickupMethod }} · {{ booking.delivery ? (booking.deliveryAddress ?: 'Delivery address on booking') : booking.pickupLocation }}</small></td>
                        <td><span class="status-badge status-badge--{{ booking.vehicle.availabilityStatus|status_class }}">{{ booking.vehicle.availabilityStatus|humanize_label }}</span></td>
                        <td>
                            <form class="admin-inline-form" method="post" action="{{ path('app_admin_booking_ready', {id: booking.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('booking-ready-' ~ booking.id) }}">
                                <input type="hidden" name="decision" value="ready">
                                <input class="form-control form-control-sm" name="admin_note" maxlength="3000" placeholder="Preparation note" aria-label="Preparation note">
                                <button class="btn btn-primary btn-sm" type="submit"><i class="bi bi-key" aria-hidden="true"></i> {{ booking.delivery ? 'Mark Ready for Delivery' : 'Mark Ready for Pickup' }}</button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="5">No confirmed bookings are waiting for vehicle preparation.</td></tr>
                {% endfor %}
                </tbody></table></div>
            </article>

            <article class="admin-editor mt-4" id="status-controls">
                <div class="admin-editor__heading"><div><span class="section-kicker">Status controls</span><h2>Bookings before checkout</h2><p>Reject a pending booking or cancel one before pickup; everything verified as paid is refunded in full. Mark a booking as a no-show once its pickup time has passed without checkout (no automatic refund). Unpaid pending bookings are released automatically after {{ constant('App\\Service\\Booking\\BookingStatusManager::UNPAID_HOLD') }} or at pickup.</p></div><span class="dashboard-queue__count">{{ controls|length }}</span></div>
                <div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Booking</th><th>Customer</th><th>Pickup</th><th>Status</th><th>Action</th></tr></thead><tbody>
                {% for booking in controls %}
                    {% set missed = booking.status in ['confirmed', 'ready'] and booking.pickupAt < now %}
                    <tr>
                        <td><strong>{{ booking.reference }}</strong><small>{{ booking.vehicle.name }}</small></td>
                        <td>{{ booking.user.name }}<small>{{ booking.user.email }}</small></td>
                        <td>{{ booking.pickupAt|date('M j, Y g:i A') }}{% if missed %}<small><span class="status-badge status-badge--warning">Not collected</span></small>{% endif %}</td>
                        <td><span class="status-badge status-badge--{{ booking.status|status_class }}">{{ booking.status|humanize_label }}</span></td>
                        <td>
                            {% if booking.status == 'pending' %}{{ f.status_form('app_admin_booking_reject', 'booking-reject-', booking, 'Reject', 'Reason (sent to the customer)') }}{% endif %}
                            {% if missed %}{{ f.status_form('app_admin_booking_no_show', 'booking-no-show-', booking, 'Mark No-show', 'Note (optional)') }}{% endif %}
                            {{ f.status_form('app_admin_booking_cancel', 'booking-cancel-', booking, 'Cancel Booking', 'Reason (sent to the customer)') }}
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="5">No bookings are waiting for pickup.</td></tr>
                {% endfor %}
                </tbody></table></div>
            </article>
        </div>
    </div>
</section>
{% endblock %}
