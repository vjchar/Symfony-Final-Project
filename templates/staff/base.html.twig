{% extends 'base.html.twig' %}

{# Staff pages use the operations layout (no booking call-to-action band). #}
{% block admin_context %}1{% endblock %}

{% block body %}
{# administrators can open staff pages too, so they keep their own navigation #}
{{ include(is_granted('ROLE_ADMIN') ? 'admin/_nav.html.twig' : 'staff/_nav.html.twig') }}
<section class="admin-page-heading">
    <div class="container">
        <div>
            <span class="section-kicker">{% block staff_kicker %}{{ is_granted('ROLE_ADMIN') ? 'Record management' : 'Staff workspace' }}{% endblock %}</span>
            <h1>{% block staff_heading %}{% endblock %}</h1>
            {% block staff_intro %}{% endblock %}
        </div>
        {% block staff_actions %}{% endblock %}
    </div>
</section>
<section class="content-section admin-section">
    <div class="container">
        {% block staff_body %}{% endblock %}
    </div>
</section>
{% endblock %}
