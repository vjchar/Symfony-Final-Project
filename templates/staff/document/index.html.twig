{% extends 'staff/base.html.twig' %}

{% block title %}Documents | Staff | VJ Car Rental{% endblock %}

{% block staff_kicker %}Identity checks{% endblock %}
{% block staff_heading %}Document verification{% endblock %}
{% block staff_intro %}<p>Open each file and check that the name, number and expiry match the customer. Approving the last missing document confirms their paid bookings.</p>{% endblock %}

{% block staff_body %}
<div class="admin-filter-tabs">
    {% for status in filters %}
        <a class="{{ filter == status ? 'active' }}" href="{{ path('app_staff_documents', {status: status}) }}">{{ status|humanize_label }}</a>
    {% endfor %}
</div>

<div class="admin-table-wrap">
    <table class="admin-table">
        <thead>
            <tr><th>Customer</th><th>Document</th><th>Expiry</th><th>Submitted</th><th>Status</th><th>Review</th></tr>
        </thead>
        <tbody>
            {% for document in documents %}
                <tr data-document="{{ document.id }}">
                    <td><strong>{{ document.user.name }}</strong><small>{{ document.user.email }}</small></td>
                    <td>
                        {{ document.documentType|humanize_label }}
                        <small>{{ document.maskedNumber }} · <a href="{{ path('app_file_document', {id: document.id}) }}" target="_blank" rel="noopener"><i class="bi bi-file-earmark-lock" aria-hidden="true"></i> Open file</a></small>
                    </td>
                    <td>{{ document.expiryDate ? document.expiryDate|date('M j, Y') : '—' }}</td>
                    <td>{{ document.updatedAt|date('M j, Y g:i A') }}</td>
                    <td>
                        <span class="status-badge status-badge--{{ document.effectiveStatus|status_class }}">{{ document.effectiveStatus|humanize_label }}</span>
                        {% if document.verifiedBy %}<small>by {{ document.verifiedBy is same as(app.user) ? 'you' : document.verifiedBy.name }}</small>{% endif %}
                        {% if document.adminNotes %}<small>{{ document.adminNotes }}</small>{% endif %}
                    </td>
                    <td>
                        <form class="admin-inline-form" method="post" action="{{ path('app_staff_document_review', {id: document.id, status: filter}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('review-document-' ~ document.id) }}">
                            <select class="form-select form-select-sm" name="status" required aria-label="Decision for {{ document.user.name }}’s {{ document.label }}">
                                <option value="">Decision</option>
                                <option value="approved">Approve</option>
                                <option value="rejected">Reject</option>
                            </select>
                            <input class="form-control form-control-sm" name="notes" maxlength="2000" placeholder="Reason or note" aria-label="Reviewer note">
                            <button class="btn btn-primary btn-sm" type="submit">Save</button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="6" class="staff-empty-cell"><i class="bi bi-check2-circle" aria-hidden="true"></i> {{ filter == 'pending' ? 'No documents are waiting for verification.' : 'No documents match this filter.' }}</td></tr>
            {% endfor %}
        </tbody>
    </table>
    {{ include('admin/_pagination.html.twig', {page: documents}) }}
</div>
{% endblock %}
