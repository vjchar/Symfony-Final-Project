{% extends 'admin/base.html.twig' %}

{% block title %}Rental Desk | VJ Car Rental{% endblock %}

{% block admin_body %}
<section class="admin-page-heading">
    <div class="container">
        <div>
            <span class="section-kicker">Checkout and check-in</span>
            <h1>Rental Desk</h1>
            <p>
                Release prepared vehicles, capture odometer and fuel readings,
                inspect returns, and close fully paid rentals.
            </p>
        </div>
    </div>
</section>
<section class="content-section admin-section">
    <div class="container">
        <article class="admin-editor mb-4" id="adjustment-queue">
            <div class="admin-editor__heading">
                <div>
                    <span class="section-kicker">Flexible rental requests</span>
                    <h2>Rental adjustments</h2>
                    <p>Review early-return requests and extension requests. Availability is checked again when an extension is approved; an approved early return moves the scheduled return, reprices the rental, and refunds paid unused days.</p>
                </div>
                <span class="status-badge status-badge--info">{{ adjustments|length }} open</span>
            </div>
            <div class="admin-table-wrap">
                <table class="admin-table">
                    <thead><tr><th>Booking</th><th>Customer / vehicle</th><th>Request</th><th>Schedule</th><th>Price impact</th><th>Status</th><th>Review</th></tr></thead>
                    <tbody>
                    {% for adjustment in adjustments %}
                        <tr>
                            <td><a href="{{ path('app_admin_rentals', {reference: adjustment.booking.reference}) }}"><strong>{{ adjustment.booking.reference }}</strong></a></td>
                            <td>{{ adjustment.user.name }}<small>{{ adjustment.booking.vehicle.name }}</small></td>
                            <td>{{ adjustment.requestType|humanize_label }}<small>{{ adjustment.customerReason ?: 'No reason provided' }}</small></td>
                            <td>{{ adjustment.originalReturnAt|date('M j, g:i A') }}<small>to {{ adjustment.requestedReturnAt|date('M j, g:i A') }}</small></td>
                            <td>{% if adjustment.priceDifference > 0 %}+{{ adjustment.priceDifference|money }}{% elseif adjustment.priceDifference < 0 %}−{{ (adjustment.priceDifference|abs)|money }}<small>Unused days; refunded if already paid</small>{% else %}—{% endif %}</td>
                            <td><span class="status-badge status-badge--{{ adjustment.status|status_class }}">{{ adjustment.status|humanize_label }}</span></td>
                            <td>
                                {% if adjustment.pending %}
                                <form method="post" class="admin-inline-form" action="{{ path('app_admin_adjustment_review', {id: adjustment.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('review-adjustment-' ~ adjustment.id) }}">
                                    <select class="form-select form-select-sm" name="decision" required><option value="">Decision</option><option value="approve">Approve</option><option value="reject">Reject</option></select>
                                    <input class="form-control form-control-sm" name="admin_note" maxlength="1500" placeholder="Admin note">
                                    <button class="btn btn-primary btn-sm" type="submit">Save</button>
                                </form>
                                {% elseif adjustment.extension %}
                                    <small>Awaiting extension payment / activation</small>
                                {% else %}
                                    {# early returns approved before they were applied to the booking #}
                                    <small>Early return approved; closes at check-in</small>
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="7">No open rental adjustment requests.</td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </article>

        <div class="admin-table-wrap" aria-label="Rentals requiring desk action" id="rental-queue">
            <table class="admin-table">
                <thead><tr><th>Booking</th><th>Customer</th><th>Schedule</th><th>Fleet state</th><th>Status</th><th><span class="visually-hidden">Action</span></th></tr></thead>
                <tbody>
                {% for rental in rentals %}
                    <tr>
                        <td><strong>{{ rental.reference }}</strong><small>{{ rental.vehicle.name }}</small></td>
                        <td>{{ rental.user.name }}</td>
                        <td>{{ rental.pickupAt|date('M j, g:i A') }}<small>to {{ rental.returnAt|date('M j, g:i A') }}</small></td>
                        <td><span class="status-badge status-badge--{{ rental.vehicle.availabilityStatus|status_class }}">{{ rental.vehicle.availabilityStatus|humanize_label }}</span></td>
                        <td><span class="status-badge status-badge--{{ rental.status|status_class }}">{{ rental.status|humanize_label }}</span></td>
                        <td><a class="btn btn-outline btn-sm" href="{{ path('app_admin_rentals', {reference: rental.reference}) }}">Open</a></td>
                    </tr>
                {% else %}
                    <tr><td colspan="6">No rentals currently need desk action.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>

        {% if selected %}
            {% set reference = selected.reference %}
            <article class="admin-editor mt-4" id="rental-desk">
                <div class="admin-editor__heading">
                    <div>
                        <span class="section-kicker">{{ reference }}</span>
                        <h2>{{ selected.vehicle.name }}</h2>
                    </div>
                    <span class="status-badge status-badge--{{ selected.status|status_class }}">{{ selected.status|humanize_label }}</span>
                </div>

                {% if selected_adjustments %}
                    <div class="rental-adjustment-history mb-4">
                        <h3>Return schedule history</h3>
                        {% for adjustment in selected_adjustments %}
                            <div class="adjustment-history-item">
                                <strong>{{ adjustment.requestType|humanize_label }}</strong>
                                <span>{{ adjustment.originalReturnAt|date('M j, Y g:i A') }} → {{ adjustment.requestedReturnAt|date('M j, Y g:i A') }}</span>
                                <span class="status-badge status-badge--{{ adjustment.status|status_class }}">{{ adjustment.status|humanize_label }}</span>
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}

                {% if selected.status in ['ready', 'active'] %}
                    {% set action = selected.status == 'ready' ? 'checkout' : 'checkin' %}
                    {% set prior = inspections.checkout ?? null %}
                    {% set minimum_odometer = prior ? prior.odometer : 0 %}
                    <form method="post" class="row g-3 rental-inspection-form" action="{{ path('app_admin_rental_' ~ action, {reference: reference}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('rental-' ~ action ~ '-' ~ selected.id) }}">
                        <div class="col-md-4">
                            <label class="form-label" for="odometer">Odometer (km)</label>
                            <input class="form-control" id="odometer" name="odometer" type="number" min="{{ minimum_odometer }}" max="2000000" placeholder="Enter the dashboard reading" aria-describedby="odometerHelp" required>
                            <div class="form-text" id="odometerHelp">
                                {% if prior %}
                                    Return reading must be at least {{ minimum_odometer|number_format }} km.
                                {% else %}
                                    Enter the actual dashboard reading before releasing the vehicle.
                                {% endif %}
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="fuelPercent">Fuel / charge (%)</label>
                            <input class="form-control" id="fuelPercent" name="fuel_percent" type="number" min="0" max="100" value="100" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="bodyCondition">Vehicle condition</label>
                            <select class="form-select" id="bodyCondition" name="body_condition" required>
                                <option value="excellent">Excellent</option>
                                <option value="good" selected>Good</option>
                                <option value="fair">Fair</option>
                                <option value="damaged">Damaged</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="inspectionNotes">Inspection notes</label>
                            <textarea class="form-control" id="inspectionNotes" name="notes" rows="3" maxlength="3000"></textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="damageNotes">Damage / exception notes</label>
                            <textarea class="form-control" id="damageNotes" name="damage_notes" rows="3" maxlength="3000"></textarea>
                        </div>
                        {% if action == 'checkin' %}
                            <div class="col-md-4">
                                <label class="form-label" for="extraCharges">Extra charges (PHP)</label>
                                <input class="form-control" id="extraCharges" name="extra_charges" type="number" min="0" max="1000000" value="0" required>
                            </div>
                        {% endif %}
                        <div class="col-12">
                            <button class="btn btn-primary" type="submit">
                                <i class="bi bi-{{ action == 'checkout' ? 'key' : 'clipboard-check' }}" aria-hidden="true"></i>
                                Record {{ action|humanize_label }}
                            </button>
                        </div>
                    </form>
                {% else %}
                    <div class="payment-overview">
                        <article><span>Security deposit held</span><strong>{{ preview.depositHeld|money }}</strong></article>
                        <article><span>Return inspection charges</span><strong>{{ preview.inspectionCharge|money }}</strong></article>
                        <article><span>Outstanding return balance</span><strong>{{ payment_summary.extraDue|money }}</strong></article>
                    </div>
                    {% if not settlement %}
                        <div class="alert alert-info">Break down the recorded return charge, then finalize settlement. The verified security deposit will be applied first; only any remaining balance becomes payable.</div>
                        <form method="post" class="row g-3 rental-settlement-form" action="{{ path('app_admin_rental_settle', {reference: reference}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('rental-settle-' ~ selected.id) }}">
                            <div class="col-md-3"><label class="form-label" for="damageCharges">Damage charges</label><input class="form-control" id="damageCharges" name="damage_charges" type="number" min="0" value="0" required></div>
                            <div class="col-md-3"><label class="form-label" for="fuelCharges">Fuel charges</label><input class="form-control" id="fuelCharges" name="fuel_charges" type="number" min="0" value="0" required></div>
                            <div class="col-md-3"><label class="form-label" for="lateCharges">Late charges</label><input class="form-control" id="lateCharges" name="late_charges" type="number" min="0" value="0" required></div>
                            <div class="col-md-3"><label class="form-label" for="otherCharges">Other recorded charges</label><input class="form-control" id="otherCharges" name="other_charges" type="number" min="0" value="{{ preview.inspectionCharge }}" required></div>
                            <div class="col-12"><small class="display-note">These four amounts must total {{ preview.inspectionCharge|money }}, the charge already recorded during return inspection.</small></div>
                            <div class="col-12"><label class="form-label" for="settlementNotes">Settlement notes</label><textarea class="form-control" id="settlementNotes" name="settlement_notes" rows="3" maxlength="3000"></textarea></div>
                            <div class="col-12"><button class="btn btn-primary" type="submit">Finalize Return Settlement</button></div>
                        </form>
                    {% else %}
                        <div class="admin-editor__heading mt-4">
                            <div><span class="section-kicker">Security deposit settlement</span><h3>Final settlement</h3></div>
                            <span class="status-badge status-badge--{{ settlement.status|status_class }}">{{ settlement.status|humanize_label }}</span>
                        </div>
                        {{ include('booking/_settlement_figures.html.twig') }}
                        {% if refunds %}
                            <div class="admin-table-wrap mt-3">
                                <table class="admin-table">
                                    <thead><tr><th>Refund type</th><th>Amount</th><th>Status</th><th>Reference</th></tr></thead>
                                    <tbody>
                                    {% for refund in refunds %}
                                        <tr><td>{{ refund.refundTypeLabel }}</td><td>{{ refund.amount|money }}</td><td>{{ refund.status|humanize_label }}</td><td>{{ refund.referenceNumber ?: '—' }}</td></tr>
                                    {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        {% endif %}
                    {% endif %}
                    {% set settled = settlement and settlement.settled %}
                    <form method="post" class="rental-completion-form mt-4" action="{{ path('app_admin_rental_complete', {reference: reference}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('rental-complete-' ~ selected.id) }}">
                        <label class="form-label" for="completionNotes">Completion notes</label>
                        <textarea class="form-control" id="completionNotes" name="admin_notes" rows="3" maxlength="3000"></textarea>
                        <div class="d-flex flex-wrap gap-2 mt-3">
                            <button class="btn btn-primary" type="submit" {{ not settled ? 'disabled' }}>Complete Rental</button>
                            <a class="btn btn-outline" href="{{ path('app_admin_payments') }}#refund-history">Review Payments &amp; Refunds</a>
                        </div>
                        {% if not settled %}<small class="display-note">Complete the return settlement and any refund/outstanding balance first.</small>{% endif %}
                    </form>
                {% endif %}
            </article>
        {% endif %}
    </div>
</section>
{% endblock %}
