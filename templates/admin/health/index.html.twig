{% extends 'admin/base.html.twig' %}

{% block title %}System Health | VJ Car Rental{% endblock %}

{% block admin_body %}
<section class="admin-page-heading">
    <div class="container">
        <div>
            <span class="section-kicker">Deployment readiness</span>
            <h1>System health</h1>
            <p>Checks for the database connection, upload folders, and security settings.</p>
        </div>
        <span class="status-badge status-badge--{{ healthy ? 'success' : 'warning' }}">{{ healthy ? 'All checks passed' : 'Action required' }}</span>
    </div>
</section>
<section class="content-section admin-section">
    <div class="container">
        <div class="health-grid">
            {% for check in checks %}
                <article class="health-check {{ check.passed ? 'is-passed' : 'is-warning' }}">
                    <i class="bi {{ check.passed ? 'bi-check-circle-fill' : 'bi-exclamation-triangle-fill' }}"></i>
                    <span>
                        <strong>{{ check.label }}</strong>
                        <small>{{ check.detail }}</small>
                    </span>
                </article>
            {% endfor %}
        </div>
        <div class="booking-note mt-4">
            <strong>System check:</strong> review any failed items before using the application for live operations.
        </div>
    </div>
</section>
{% endblock %}
