{% extends 'base.html.twig' %}

{% block title %}Booking Not Found | VJ Car Rental{% endblock %}

{% block body %}
<section class="content-section error-page">
    <div class="container">
        <i class="bi bi-calendar-x"></i>
        <h1>{{ heading ?? 'Booking not found' }}</h1>
        <p>{{ message ?? 'The reservation does not exist or is not available to this account.' }}</p>
        <a class="btn btn-primary" href="{{ path('app_my_bookings') }}">My Bookings</a>
    </div>
</section>
{% endblock %}
