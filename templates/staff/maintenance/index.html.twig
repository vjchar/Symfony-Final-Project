{% extends 'staff/base.html.twig' %}

{% block title %}Maintenance | Staff | VJ Car Rental{% endblock %}

{% block staff_heading %}Maintenance records{% endblock %}
{% block staff_intro %}<p>{{ is_granted('ROLE_ADMIN') ? 'Every service event logged by staff. As an administrator you can edit or delete any record.' : 'Every service event in the fleet. You can edit or delete the records you created.' }}</p>{% endblock %}

{% block staff_body %}
<p>
    <a class="btn btn-primary" href="{{ path('app_staff_maintenance_new') }}">
        <i class="bi bi-plus-circle" aria-hidden="true"></i> New Record
    </a>
    <a class="btn btn-outline" href="{{ path('app_profile') }}">
        <i class="bi bi-person-gear" aria-hidden="true"></i> My Profile
    </a>
</p>

<form class="admin-search" method="get" action="{{ path('app_staff_maintenance') }}" role="search">
    <label class="visually-hidden" for="recordSearch">Search records</label>
    <input class="form-control" id="recordSearch" name="q" value="{{ query }}" placeholder="Search vehicle, service, description or staff name">
    <label class="visually-hidden" for="recordStatus">Status</label>
    <select class="form-select" id="recordStatus" name="status">
        <option value="">All statuses</option>
        {% for option in statuses %}
            <option value="{{ option }}" {{ status == option ? 'selected' }}>{{ option|humanize_label }}</option>
        {% endfor %}
    </select>
    <button class="btn btn-primary" type="submit"><i class="bi bi-search" aria-hidden="true"></i> Search</button>
    {% if query != '' or status != '' %}
        <a class="btn btn-outline" href="{{ path('app_staff_maintenance') }}">Clear</a>
    {% endif %}
</form>
<p class="record-count">
    {% if query != '' or status != '' %}
        Showing {{ records|length }} of {{ total }} {{ total == 1 ? 'record' : 'records' }}
    {% else %}
        {{ total }} {{ total == 1 ? 'record' : 'records' }}
    {% endif %}
</p>

<div class="admin-table-wrap">
    <table class="admin-table">
        <thead>
            <tr>
                <th>Vehicle</th>
                <th>Service</th>
                <th>Schedule</th>
                <th>Cost</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for record in records %}
                <tr data-record="{{ record.id }}">
                    <td>
                        <strong>{{ record.vehicle.name }}</strong>
                        <small>Created by {{ record.createdBy is same as(app.user) ? 'you' : record.createdBy.name }}</small>
                    </td>
                    <td>{{ record.title }}</td>
                    <td>{{ record.startsAt|date('M j, Y g:i A') }}</td>
                    <td>{{ record.cost|money }}</td>
                    <td>
                        <span class="status-badge status-badge--{{ record.status|status_class }}">{{ record.status|humanize_label }}</span>
                    </td>
                    <td>
                        <a class="btn btn-outline btn-sm" href="{{ path('app_staff_maintenance_show', {id: record.id}) }}">View</a>
                        {% if is_granted('MAINTENANCE_EDIT', record) %}
                            <a class="btn btn-outline btn-sm" href="{{ path('app_staff_maintenance_edit', {id: record.id}) }}">Edit</a>
                        {% endif %}
                        {% if is_granted('MAINTENANCE_DELETE', record) %}
                            <a class="btn btn-outline btn-sm" href="{{ path('app_staff_maintenance_delete', {id: record.id}) }}">Delete</a>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6">{{ query != '' or status != '' ? 'No records match your search.' : 'No maintenance records yet.' }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
