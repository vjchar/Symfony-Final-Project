{#
    One contact enquiry with its reply and status forms.
    Variables: message, statuses, reply_url, status_url.
#}
<article class="admin-message-card">
    <header>
        <div>
            <span class="status-badge status-badge--{{ message.status|status_class }}">{{ message.status|humanize_label }}</span>
            <h2>{{ message.subject }}</h2>
            <small>{{ message.createdAt|date('M j, Y g:i A') }}</small>
        </div>
        <a href="mailto:{{ message.email }}?subject={{ ('Re: ' ~ message.subject)|url_encode }}" class="btn btn-outline btn-sm">
            <i class="bi bi-envelope"></i> Open in email app</a>
    </header>
    <p>{{ message.message|nl2br }}</p>
    {% if message.repliedAt %}
        <div class="review-note mb-3"><strong>Replied {{ message.repliedAt|date('M j, Y g:i A') }}{{ message.repliedBy ? ' by ' ~ message.repliedBy.name }}</strong><p>{{ message.reply|nl2br }}</p></div>
    {% endif %}
    <form method="post" class="mb-3 contact-reply-form" action="{{ reply_url }}">
        <input type="hidden" name="_token" value="{{ csrf_token('contact-reply-' ~ message.id) }}">
        <label class="form-label" for="reply-{{ message.id }}">{{ message.repliedAt ? 'Send another reply' : 'Reply to ' ~ message.name }}</label>
        <textarea class="form-control mb-2" id="reply-{{ message.id }}" name="reply" rows="3" minlength="5" maxlength="5000" required></textarea>
        <button class="btn btn-outline btn-sm" type="submit"><i class="bi bi-reply" aria-hidden="true"></i> Email Reply</button>
    </form>
    <footer>
        <span>
            <strong>{{ message.name }}</strong>
            <small>
                <a href="mailto:{{ message.email }}">{{ message.email }}</a>{{ message.phone ? ' • ' ~ message.phone }}</small>
        </span>
        <form method="post" class="admin-inline-form" action="{{ status_url }}">
            <input type="hidden" name="_token" value="{{ csrf_token('contact-message-' ~ message.id) }}">
            <input type="hidden" name="message_id" value="{{ message.id }}">
            <select class="form-select" name="status" aria-label="Message status">
                {% for status in statuses %}
                    <option value="{{ status }}" {{ message.status == status ? 'selected' }}>{{ status|humanize_label }}</option>
                {% endfor %}
            </select>
            <button class="btn btn-primary" type="submit">Save</button>
        </form>
    </footer>
</article>
