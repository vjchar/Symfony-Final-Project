{% extends 'base.html.twig' %}

{% block title %}Cancel Booking {{ booking.reference }} | VJ Car Rental{% endblock %}

{% block body %}
<section class="page-hero page-hero--compact pattern-layer"><div class="container"><span class="section-kicker">Cancellation &amp; refund</span><h1>Booking {{ booking.reference }}</h1><p>Review the recorded payments and current refund estimate before requesting cancellation.</p></div></section>
<section class="content-section"><div class="container">
{% for error in errors %}<div class="alert alert-danger">{{ error }}</div>{% endfor %}
<div class="row g-4 align-items-start">
<div class="col-lg-7">
<article class="operation-card">
<span class="section-kicker">Cancellation status</span><h2>{{ cancellation ? cancellation.status|humanize_label : 'Request cancellation' }}</h2>
<div class="confirmation-details">
<span><small>Vehicle</small><strong>{{ booking.vehicle.name }}</strong></span>
<span><small>Pickup</small><strong>{{ booking.pickupAt|date('M j, Y g:i A') }}</strong></span>
<span><small>Paid amount available</small><strong>{{ estimate.paid|money }}</strong></span>
<span><small>Estimated refundable</small><strong>{{ (cancellation ? cancellation.refundableAmount : estimate.refundable)|money }}</strong></span>
<span><small>Estimated non-refundable</small><strong>{{ (cancellation ? cancellation.nonRefundableAmount : estimate.nonRefundable)|money }}</strong></span>
</div>
{% if cancellation %}
<p class="display-note mt-3">Reason: {{ cancellation.reason }}</p>
{% if cancellation.adminNote %}<p class="display-note">Admin note: {{ cancellation.adminNote }}</p>{% endif %}
{% elseif booking.prePickup and estimate.hoursToPickup > 0 %}
{% if estimate.hoursToPickup > cutoff_hours %}
<div class="alert alert-info mt-3">Under the current configurable policy, verified payments are fully refundable when an eligible cancellation is approved more than {{ cutoff_hours }} hours before pickup.</div>
{% else %}
<div class="alert alert-warning mt-3">Pickup is within {{ cutoff_hours }} hours. You may still submit a cancellation request for Admin review, but the standard refundable window has closed and no automatic refund is due under the current policy.</div>
{% endif %}
<form method="post" class="mt-3" action="{{ path('app_booking_cancellation', {reference: booking.reference}) }}">
{{ form_widget(form._token) }}
<label class="form-label" for="cancelReason">Cancellation reason</label>
<textarea class="form-control" id="cancelReason" name="reason" rows="4" maxlength="2000" required></textarea>
<button class="btn btn-outline-danger mt-3" type="submit">Request Cancellation</button>
</form>
{% elseif booking.prePickup %}
<div class="alert alert-warning mt-3">The scheduled pickup time has already passed. Contact VJ Car Rental support for assistance.</div>
{% else %}<div class="alert alert-warning mt-3">This booking is no longer eligible for normal pre-pickup cancellation.</div>{% endif %}
</article>
</div>
<div class="col-lg-5"><aside class="booking-summary-card sticky-lg-top"><span class="section-kicker">Refund estimate</span><div class="summary-line"><span>Current booking total</span><strong>{{ booking.total|money }}</strong></div><div class="summary-line"><span>Verified paid amount</span><strong>{{ estimate.paid|money }}</strong></div><div class="summary-line"><span>Refundable</span><strong>{{ estimate.refundable|money }}</strong></div><div class="summary-line"><span>Non-refundable</span><strong>{{ estimate.nonRefundable|money }}</strong></div><p class="display-note mt-3">Final refund records are created only after Admin approves an eligible cancellation. Refunds remain linked to the original verified payment.</p></aside></div>
</div>
</div></section>
{% endblock %}
