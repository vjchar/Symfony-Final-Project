{% extends 'admin/base.html.twig' %}

{% block title %}Administration | VJ Car Rental{% endblock %}

{% block admin_body %}
<section class="admin-hero admin-dashboard-hero">
    <div class="container">
        <div class="admin-dashboard-hero__copy">
            <span class="section-kicker">Operations dashboard</span>
            <h1>{{ greeting }}, {{ app.user.firstName }}</h1>
            <p>
                Monitor reservations, verification, payments, active rentals,
                returns, and fleet readiness from one clear operations view.
            </p>

            <div class="admin-dashboard-hero__meta" aria-label="Dashboard date and purpose">
                <span>
                    <i class="bi bi-calendar3" aria-hidden="true"></i>
                    {{ 'now'|date('l, F j, Y') }}
                </span>
                <span>
                    <i class="bi bi-grid-1x2" aria-hidden="true"></i>
                    Live operations overview
                </span>
            </div>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-primary admin-dashboard-hero__action" href="{{ page_url('admin-bookings') }}"><i class="bi bi-calendar2-check" aria-hidden="true"></i> Review bookings</a>
            <a class="btn btn-outline-light admin-dashboard-hero__action" href="{{ page_url('admin-calendar') }}"><i class="bi bi-calendar3" aria-hidden="true"></i> Rental calendar</a>
        </div>
    </div>
</section>

<section class="content-section admin-section admin-dashboard">
    <div class="container">
        <div class="admin-stats admin-dashboard-stats" aria-label="Operations summary">
            {% for stat in [
                {mod: 'customer', icon: 'bi-person-lines-fill', label: 'Total users', value: counts.users, text: 'All accounts, every role'},
                {mod: 'booking', icon: 'bi-person-badge', label: 'Total staff', value: counts.staff, text: counts.active_staff ~ ' active staff ' ~ (counts.active_staff == 1 ? 'account' : 'accounts')},
                {mod: 'fleet', icon: 'bi-journal-text', label: 'Total records', value: counts.records, text: counts.open_records ~ ' maintenance ' ~ (counts.open_records == 1 ? 'record' : 'records') ~ ' open'},
                {mod: 'fleet', icon: 'bi-car-front', label: 'Active vehicles', value: counts.vehicles, text: 'Bookable fleet records'},
                {mod: 'customer', icon: 'bi-people', label: 'Active customers', value: counts.customers, text: 'Enabled customer accounts'},
                {mod: 'clear', icon: 'bi-check2-circle', label: 'Ready to rent', value: counts.available, text: 'Available right now'},
                {mod: counts.maintenance > 0 ? 'attention' : 'clear', icon: 'bi-tools', label: 'In maintenance', value: counts.maintenance, text: counts.maintenance > 0 ? 'Service downtime in progress' : 'No vehicles in service'},
                {mod: 'booking', icon: 'bi-plus-circle', label: 'Active add-ons', value: counts.addons, text: 'Offered during booking'},
                {mod: counts.new_messages > 0 ? 'attention' : 'clear', icon: 'bi-envelope', label: 'New messages', value: counts.new_messages, text: counts.new_messages > 0 ? 'Needs a reply' : 'Inbox is clear'},
            ] %}
                <article class="dashboard-stat dashboard-stat--{{ stat.mod }}" data-stat="{{ stat.label|lower|replace({' ': '-'}) }}">
                    <span class="dashboard-stat__icon" aria-hidden="true">
                        <i class="bi {{ stat.icon }}"></i>
                    </span>
                    <span class="dashboard-stat__content">
                        <small>{{ stat.label }}</small>
                        <strong>{{ stat.value }}</strong>
                        <span>{{ stat.text }}</span>
                    </span>
                </article>
            {% endfor %}
        </div>

        <div class="dashboard-workspace">
            <section class="dashboard-panel dashboard-recent-bookings">
                <div class="dashboard-panel__header">
                    <div>
                        <span class="section-kicker">Latest activity</span>
                        <h2>Recent bookings</h2>
                        <p>Newest reservations and their current status.</p>
                    </div>

                    <a class="dashboard-panel__link" href="{{ page_url('admin-bookings') }}">
                        View all
                        <i class="bi bi-arrow-right" aria-hidden="true"></i>
                    </a>
                </div>

                <div class="dashboard-empty">
                    <span class="dashboard-empty__icon" aria-hidden="true">
                        <i class="bi bi-calendar2-plus"></i>
                    </span>
                    <strong>No bookings yet</strong>
                    <p>New customer reservations will appear here.</p>
                </div>
            </section>
            <aside class="dashboard-panel dashboard-operations-queue">
                <div class="dashboard-panel__header">
                    <div>
                        <span class="section-kicker">Immediate work</span>
                        <h2>Operations queue</h2>
                        <p>Open the areas that need daily attention.</p>
                    </div>
                </div>
                <nav class="dashboard-queue" aria-label="Operations shortcuts">
                    {% for item in [
                        {page: 'admin-vehicles', icon: 'bi-car-front', title: 'Vehicles', text: 'Fleet records and pricing'},
                        {page: 'admin-addons', icon: 'bi-plus-circle', title: 'Add-ons', text: 'Optional rental extras'},
                        {page: 'admin-users', icon: 'bi-people', title: 'Users', text: 'Customers and staff'},
                        {page: 'admin-reports', icon: 'bi-bar-chart-line', title: 'Reports', text: 'Export and print summaries'},
                    ] %}
                        <a href="{{ page_url(item.page) }}">
                            <span class="dashboard-queue__icon" aria-hidden="true">
                                <i class="bi {{ item.icon }}"></i>
                            </span>
                            <span class="dashboard-queue__copy">
                                <strong>{{ item.title }}</strong>
                                <small>{{ item.text }}</small>
                            </span>
                            <i class="bi bi-chevron-right dashboard-queue__arrow" aria-hidden="true"></i>
                        </a>
                    {% endfor %}
                </nav>
            </aside>
        </div>
        <div class="dashboard-insights">
            <section class="dashboard-panel dashboard-status-panel">
                <div class="dashboard-panel__header">
                    <div>
                        <span class="section-kicker">Fleet mix</span>
                        <h2>Vehicles by category</h2>
                        <p>Distribution of bookable vehicles across every category.</p>
                    </div>
                    <a class="dashboard-panel__link" href="{{ page_url('admin-vehicles') }}">
                        Manage fleet
                        <i class="bi bi-arrow-right" aria-hidden="true"></i>
                    </a>
                </div>
                <div class="dashboard-status-bars">
                    {% for category, total in category_counts %}
                        <div class="dashboard-status-row">
                            <span>{{ category }}</span>
                            <span class="dashboard-status-row__track" aria-hidden="true">
                                <i style="--dashboard-bar-size: {{ max(4, (total / category_maximum * 100)|round) }}%;"></i>
                            </span>
                            <strong>{{ total }}</strong>
                        </div>
                    {% endfor %}
                </div>
            </section>
        </div>
    </div>
</section>
{% endblock %}
