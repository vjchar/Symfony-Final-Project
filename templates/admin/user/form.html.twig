{% extends 'admin/base.html.twig' %}

{% block title %}{{ user ? 'Edit User' : 'New User' }} | VJ Car Rental{% endblock %}

{% block admin_body %}
<section class="admin-page-heading">
    <div class="container">
        <div>
            <span class="section-kicker">Account administration</span>
            <h1>{{ user ? 'Edit ' ~ user.name : 'Create user account' }}</h1>
            <p>{{ user ? 'Correct the name, email address and phone number on this account.' : 'Create a customer, staff or administrator account with a starting password.' }}</p>
        </div>
    </div>
</section>
<section class="content-section admin-section">
    <div class="container">
        <article class="admin-editor mb-4">
            {{ form_start(form, {attr: {class: 'row g-3', novalidate: 'novalidate'}}) }}
                <div class="col-12">{{ include('registration/_errors.html.twig') }}</div>
                <div class="col-md-4">
                    {{ form_label(form.name, null, {label_attr: {class: 'form-label'}}) }}
                    {{ form_widget(form.name) }}
                </div>
                <div class="col-md-4">
                    {{ form_label(form.email, null, {label_attr: {class: 'form-label'}}) }}
                    {{ form_widget(form.email) }}
                </div>
                <div class="col-md-4">
                    {{ form_label(form.phone, null, {label_attr: {class: 'form-label'}}) }}
                    {{ form_widget(form.phone) }}
                </div>
                {% if form.role is defined %}
                    <div class="col-md-4">
                        {{ form_label(form.role, null, {label_attr: {class: 'form-label'}}) }}
                        {{ form_widget(form.role, {attr: {class: 'form-select'}}) }}
                    </div>
                    <div class="col-md-4">
                        {{ form_label(form.plainPassword.password, null, {label_attr: {class: 'form-label'}}) }}
                        {{ form_widget(form.plainPassword.password) }}
                        <small class="form-help">At least 8 characters with uppercase, lowercase, and a number.</small>
                    </div>
                    <div class="col-md-4">
                        {{ form_label(form.plainPassword.password_confirmation, null, {label_attr: {class: 'form-label'}}) }}
                        {{ form_widget(form.plainPassword.password_confirmation) }}
                    </div>
                {% endif %}
                {{ form_rest(form) }}
                <div class="col-12 d-flex flex-wrap gap-2">
                    <button class="btn btn-primary" type="submit">{{ user ? 'Save Changes' : 'Create Account' }}</button>
                    <a class="btn btn-outline" href="{{ path('app_admin_users') }}">Cancel</a>
                </div>
            {{ form_end(form) }}
        </article>
    </div>
</section>
{% endblock %}
