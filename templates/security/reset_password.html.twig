{% extends 'base.html.twig' %}

{% block title %}Choose New Password | VJ Car Rental{% endblock %}

{% block body %}
<section class="auth-section pattern-layer">
    <div class="container">
        <div class="auth-shell auth-shell--single">
            {{ form_start(form, {attr: {class: 'form auth-form', novalidate: 'novalidate'}}) }}
                <span class="section-kicker">Account recovery</span>
                <h1>Choose a new password</h1>
                {% if reset is null %}
                    <div class="alert alert-danger">This reset link is invalid or expired.</div>
                    <a class="btn btn-primary w-100" href="{{ path('app_forgot_password') }}">Request Another Link</a>
                    {% do form.setRendered %}
                {% else %}
                    {{ include('registration/_errors.html.twig') }}
                    {{ form_label(form.plainPassword.password, null, {label_attr: {class: 'form-label'}}) }}
                    {{ form_widget(form.plainPassword.password) }}
                    {{ form_label(form.plainPassword.password_confirmation, null, {label_attr: {class: 'form-label mt-3'}}) }}
                    {{ form_widget(form.plainPassword.password_confirmation) }}
                    {{ form_rest(form) }}
                    <button class="btn btn-primary w-100 mt-4" type="submit">Update Password</button>
                {% endif %}
            {{ form_end(form, {render_rest: false}) }}
        </div>
    </div>
</section>
{% endblock %}
