{% extends 'admin/base.html.twig' %}

{% block title %}Reset Password | VJ Car Rental{% endblock %}

{% block admin_body %}
<section class="admin-page-heading">
    <div class="container">
        <div>
            <span class="section-kicker">Account administration</span>
            <h1>Reset password for {{ user.name }}</h1>
            <p>{{ user.email }} will be signed out of other sessions and must use the new password. Any open password-reset link stops working.</p>
        </div>
    </div>
</section>
<section class="content-section admin-section">
    <div class="container">
        <article class="admin-editor mb-4">
            {{ form_start(form, {attr: {class: 'row g-3', novalidate: 'novalidate'}}) }}
                <div class="col-12">{{ include('registration/_errors.html.twig') }}</div>
                <div class="col-md-6">
                    {{ form_label(form.plainPassword.password, null, {label_attr: {class: 'form-label'}}) }}
                    {{ form_widget(form.plainPassword.password) }}
                    <small class="form-help">At least 8 characters with uppercase, lowercase, and a number.</small>
                </div>
                <div class="col-md-6">
                    {{ form_label(form.plainPassword.password_confirmation, null, {label_attr: {class: 'form-label'}}) }}
                    {{ form_widget(form.plainPassword.password_confirmation) }}
                </div>
                {{ form_rest(form) }}
                <div class="col-12 d-flex flex-wrap gap-2">
                    <button class="btn btn-primary" type="submit">Set New Password</button>
                    <a class="btn btn-outline" href="{{ path('app_admin_users') }}">Cancel</a>
                </div>
            {{ form_end(form) }}
        </article>
    </div>
</section>
{% endblock %}
