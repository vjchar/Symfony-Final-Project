{% extends 'base.html.twig' %}

{% block title %}Access Denied | VJ Car Rental{% endblock %}

{% block body %}
{% set is_admin = is_granted('ROLE_ADMIN') %}
{% set is_staff = is_granted('ROLE_STAFF') %}
<section class="content-section error-page pattern-layer">
    <div class="container">
        <i class="bi bi-shield-lock"></i>
        <span class="section-kicker">403 access denied</span>
        <h1>You do not have permission to open this page.</h1>
        <p>Return to your account or contact an administrator if you believe this is incorrect.</p>
        <div class="d-flex flex-wrap justify-content-center gap-2">
            {% if is_admin %}
                <a class="btn btn-primary" href="{{ page_url('admin') }}">Go to Admin Dashboard</a>
            {% elseif is_staff %}
                <a class="btn btn-primary" href="{{ page_url('staff') }}">Go to Staff Workspace</a>
            {% else %}
                <a class="btn btn-primary" href="{{ page_url('account') }}">Go to My Account</a>
            {% endif %}
        </div>
    </div>
</section>
{% endblock %}
